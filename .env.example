# Server-only. Production memberships must point to the production backend.
BLUAI_API_URL=https://backend-blueye-production.up.railway.app

# Public configuration of the Firebase WEB app in the SAME project as Bluai.
# Copy these from Firebase Console; never place service-account or Stripe secrets here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
